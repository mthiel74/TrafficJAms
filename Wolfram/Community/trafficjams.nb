 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"2170f6d7-99cc-4f57-8033-823aed49df97"],

Cell["4. The microscopic view: Intelligent Driver Model", "Section",ExpressionUUID->"56a0a4a8-873f-4545-a178-215287d20762"],

Cell[TextData[{
 "Zooming in to the level of an individual vehicle \[LongDash] indexed ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "bbf58ff7-ce42-4b8a-8721-5aa1bc2b73cb"],
 " \[LongDash] the Intelligent Driver Model (Treiber, Hennecke & Helbing, \
2000) is a second-order ODE for the longitudinal dynamics. It is written as"
}], "Text",ExpressionUUID->"3083e317-959e-443f-89df-ec0c167fcecd"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"a", " ", 
    RowBox[{"[", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         SubscriptBox["v", "\[Alpha]"], 
         SubscriptBox["v", "0"]], ")"}], "\[Delta]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["s", "*"], "(", 
          SubscriptBox["v", "\[Alpha]"], ",", " ", 
          RowBox[{"\[CapitalDelta]", 
           SubscriptBox["v", "\[Alpha]"]}], ")"}], 
         SubscriptBox["s", "\[Alpha]"]], ")"}], "2"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"5d450c23-fbff-4432-998a-7d260538d514"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "96011757-f642-47ab-b8e9-3b3360e5a7e4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "7f99bf9e-61bc-4e64-bb94-a0082f1c573b"],
 " are the speed and gap to the vehicle in front, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubscriptBox["v", "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "e32fdfe1-d8d2-4c85-869e-84e665940cc5"],
 " is the approach rate, and the desired gap is"
}], "Text",ExpressionUUID->"61eccf35-0ec1-4203-bedf-0ff61cf7df37"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["s", "*"], "(", "v", ",", " ", "\[CapitalDelta]v", ")"}], "=", 
   RowBox[{
    SubscriptBox["s", "0"], "+", 
    RowBox[{"v", "\[ThinSpace]", "T"}], "+", 
    FractionBox[
     RowBox[{"v", "\[ThinSpace]", "\[CapitalDelta]v"}], 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"a", "\[ThinSpace]", "b"}]]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"e199ed63-075b-4fc1-9fa5-a7b3c3adb9d2"],

Cell[TextData[{
 "The constants have direct physical meaning: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "679c1e7d-0b9c-4455-adab-04a79953e6b8"],
 " is the desired free-flow speed (typically 15\[ThinSpace]m/s on an urban \
road), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "54a413f9-dd34-4545-b86b-c808b37aea10"],
 " is the minimum bumper gap at standstill (2\[ThinSpace]m), ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9b050015-8101-4709-bd91-a375662a4d9d"],
 " is the safe time headway to the leader (1.5\[ThinSpace]s), and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0741c636-4d66-456e-9cff-5bae17aa7365"],
 ", ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "2c83ca46-b66e-451f-8bef-ea104ecb45c3"],
 " are the maximum acceleration and comfortable braking (1 and 1.5 m/s",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "436fdfe4-6cc7-47fa-931a-9e7dd9ee2dc0"],
 "). The acceleration exponent ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0ba64ce8-3ad2-4300-afde-342808bca72d"],
 " (typically 4) controls how sharply a driver eases off the accelerator as \
they approach their desired speed."
}], "Text",ExpressionUUID->"f2c720d7-a399-4b48-b62f-9d63e64a6916"],

Cell[TextData[{
 "Running a strongly unstable configuration \[LongDash] 25 vehicles on a 1\
\[ThinSpace]km ring (40 m mean gap), desired speed ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["v", "0"], 
    RowBox[{"=", "30"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "8de1f1ef-5c73-4795-a228-fb8d3ad0f6cd"],
 " m/s, time headway ",
 Cell[BoxData[
  FormBox[
   RowBox[{"T", 
    RowBox[{"=", "2.5"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "a86bf7a8-90b0-4cf4-b8e3-b6b775e8e108"],
 " s (so each driver wants ~75 m of gap), sluggish acceleration ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", 
    RowBox[{"=", "0.3"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "9f286d90-4f50-4128-80a8-56eacfe79231"],
 " m/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "fa952250-35eb-4b79-9ced-3e684ccee970"],
 ", and firm braking ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", 
    RowBox[{"=", "2.0"}]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "71b33014-15cc-4be0-8ec7-24e5709726e4"],
 " m/",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["s", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "70346897-4d80-40ee-a335-0689455b047b"],
 " \[LongDash] reproduces one of the most pedagogically useful results in all \
of traffic science: the ",
 StyleBox["phantom jam",
  FontSlant->Italic],
 ". A single-vehicle speed perturbation is not absorbed; instead it amplifies \
through the platoon into a persistent backward-propagating jam. The animation \
shows this both on the ring (deep-red cluster of near-stopped cars, sparse \
green free-flow arc) and in the accumulating space-time diagram below it, \
where the jam waves are the diagonal red/orange bands."
}], "Text",ExpressionUUID->"ac82df68-cbc7-4a92-b815-5f9950580a5c"],

Cell[TextData[{
 "This is exactly the same phenomenon that Sugiyama et al. (2008) \
demonstrated experimentally on a real circular track \[LongDash] their \
striking video is worth watching alongside the simulation: ",
 ButtonBox["youtube.com/watch?v=Rryu85BtALM",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://www.youtube.com/watch?v=Rryu85BtALM"], None}],
 "."
}], "Text",ExpressionUUID->"bc4b273f-c81d-4ab3-8a50-2d567fe41f91"],

