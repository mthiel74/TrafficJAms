Cell["12. Implementation notes", "Section",ExpressionUUID->"18783f08-a637-46bc-992e-14b33734d1bf"],

Cell["\<\
A few Wolfram-Language design choices that make the code short and fast:\
\>", "Text",ExpressionUUID->"293c51c9-0ca0-49c0-9413-443ad913e11d"],

Cell[TextData[{
 "\[Bullet] ",
 "Each model lives in its own ",
 StyleBox[".wl", "Input"],
 " package under ",
 StyleBox["Wolfram/", "Input"],
 " with a ",
 StyleBox["Simulate<Name>[opts]", "Input"],
 " and ",
 StyleBox["Plot<Name>[result]", "Input"],
 " entry point. The top-level ",
 StyleBox["RunAll.wls", "Input"],
 " runs every model in ~40\[ThinSpace]s end to end.\n\[Bullet] ",
 "IDM, Bando, and LWR use vectorised ",
 StyleBox["RotateLeft", "Input"],
 " to get the leader\[Hyphen]follower gaps in one call instead of a \
Python-style loop.\n\[Bullet] ",
 "The NaSch lane-changing rule uses a ",
 StyleBox["Dispatch", "Input"],
 "-backed membership test for occupied target cells, which makes the inner \
loop practically constant-time.\n\[Bullet] ",
 "Both assignment models (",
 StyleBox["NetworkAssignment", "Input"],
 ", ",
 StyleBox["DynamicAssignment", "Input"],
 ") use ",
 StyleBox["FindMinimum[{obj, constraints}, vars, Method -> \
\"InteriorPoint\"]", "Input"],
 " for the Beckmann minimisation, exploiting that it is a smooth strictly \
convex problem.\n\[Bullet] ",
 "The full-city simulator builds a single hierarchy-weighted graph once with \
per-edge random multipliers in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"[", "0.8", ",", "1.5", "]"}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "487579d1-062f-4885-b50f-ddbf37b84cdc"],
 ", giving frozen but distinct routes per vehicle. Shortest paths then use \
Wolfram's ",
 StyleBox["FindShortestPath", "Input"],
 " on this one graph; the full 600-vehicle run never touches the Graph[] \
constructor in the inner loop.\n\[Bullet] ",
 "Signal phase logic is a tiny data-driven ",
 StyleBox["Association", "Input"],
 " keyed by node: ",
 StyleBox["SignalIsGreen[ctrl, edge, simTime]", "Input"],
 " is a handful of ",
 StyleBox["Mod", "Input"],
 " / ",
 StyleBox["MemberQ", "Input"],
 " calls, not a class hierarchy.\n\[Bullet] ",
 "Animations use ",
 StyleBox["Export[path, Table[frame, ...], \"DisplayDurations\" -> ...]", 
  "Input"],
 " \[LongDash] no external ImageMagick or ffmpeg call is needed."
}], "Text",ExpressionUUID->"39639f3d-b374-449c-b3dd-b1370dfc57c3"],

Cell["13. References", "Section",ExpressionUUID->"ac14b4a4-5969-4e68-a06b-5fed75827fd5"],

Cell[TextData[{
 "\[Bullet] ",
 "M. J. Lighthill & G. B. Whitham (1955), \"On kinematic waves II: A theory \
of traffic flow on long crowded roads\", ",
 StyleBox["Proc. Roy. Soc. A",
  FontSlant->Italic],
 " 229:317\[Dash]345.\n\[Bullet] ",
 "M. Treiber, A. Hennecke & D. Helbing (2000), \"Congested traffic states in \
empirical observations and microscopic simulations\", ",
 StyleBox["Phys. Rev. E",
  FontSlant->Italic],
 " 62:1805.\n\[Bullet] ",
 "M. Treiber & A. Kesting (2013), ",
 StyleBox["Traffic Flow Dynamics: Data, Models and Simulation",
  FontSlant->Italic],
 ", Springer \[LongDash] the canonical modern textbook on the whole \
hierarchy.\n\[Bullet] ",
 "K. Nagel & M. Schreckenberg (1992), \"A cellular automaton model for \
freeway traffic\", ",
 StyleBox["J. Phys. I France",
  FontSlant->Italic],
 " 2:2221.\n\[Bullet] ",
 "M. Bando, K. Hasebe, A. Nakayama, A. Shibata & Y. Sugiyama (1995), \
\"Dynamical model of traffic congestion and numerical simulation\", ",
 StyleBox["Phys. Rev. E",
  FontSlant->Italic],
 " 51:1035.\n\[Bullet] ",
 "J. G. Wardrop (1952), \"Some theoretical aspects of road traffic \
research\", ",
 StyleBox["Proc. ICE",
  FontSlant->Italic],
 " 1(3):325\[Dash]378.\n\[Bullet] ",
 "M. J. Beckmann, C. B. McGuire & C. B. Winsten (1956), ",
 StyleBox["Studies in the Economics of Transportation",
  FontSlant->Italic],
 ", Yale U.P.\n\[Bullet] ",
 "F. V. Webster (1958), \"Traffic signal settings\", HMSO Road Research \
Technical Paper 39.\n\[Bullet] ",
 "Source code, data, and more animations: ",
 ButtonBox["github.com/mthiel74/TrafficJAms",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mthiel74/TrafficJAms"], None}],
 "."
}], "Text",ExpressionUUID->"8ff9f9c7-1c73-498d-9fb3-7f17bce5c62e"]
},
