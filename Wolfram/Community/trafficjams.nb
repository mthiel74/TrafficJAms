 CellMargins->{{0, 0}, {10, 14}},
 ShowCellLabel->False,ExpressionUUID->"813b2c02-991d-48b2-8733-2ae2c7f39495"],

Cell["5. The simplest car-following that jams: Bando OVM", "Section",ExpressionUUID->"1a7f8973-7e65-4269-bb1f-5c31d5ea0d29"],

Cell["\<\
Even simpler than IDM, the Optimal Velocity Model (Bando et al. 1995) relaxes \
speed towards a target velocity that depends only on the gap to the vehicle \
ahead:\
\>", "Text",ExpressionUUID->"60696240-fe7f-4c03-aaec-18da4d617f74"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"\[Kappa]", " ", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["V", "opt"], "(", 
      SubscriptBox["s", "\[Alpha]"], ")", "-", 
      SubscriptBox["v", "\[Alpha]"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"14fa9120-6f78-43b0-872d-9f430d8b9af6"],

Cell["with the standard choice", "Text",ExpressionUUID->"0132e052-700d-4384-ac74-efc09e1276aa"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "opt"], "(", "s", ")"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["v", "max"], "\[ThinSpace]", 
     RowBox[{"(", 
      RowBox[{"tanh", "(", 
       RowBox[{
        FractionBox["s", 
         SubscriptBox["s", "c"]], "-", "2"}], ")"}], "+", 
      RowBox[{"tanh", "(", "2", ")"}], ")"}]}], 
    RowBox[{"1", "+", 
     RowBox[{"tanh", "(", "2", ")"}]}]]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"415c4d78-abcb-4730-8f69-7dc4157fd162"],

Cell[TextData[{
 "The model has a single stability parameter, the sensitivity ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "d7306a47-9b66-4b3c-8c65-1d5b2ac7bd3e"],
 ". For ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3c8c173f-bac1-45c1-81db-b3102aaebd6c"],
 " above a critical value the uniform-flow solution is stable; below it, \
uniform flow is linearly unstable via a Hopf bifurcation and the system \
collapses into stop-and-go waves. This is the cleanest mathematical \
explanation for why phantom jams exist: they are the attractor of a dynamical \
bifurcation."
}], "Text",ExpressionUUID->"e6ff6187-7d04-4103-83ce-be44795ffa85"],

