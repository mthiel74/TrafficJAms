    {
     PaneBox[
      StyleBox["\<\"Figure 12. Wardrop-equilibrium flow on a toy 8-node \
Aberdeen-inspired network. Left: network flow map; edge thickness and colour \
encode flow. Right: path-flow distribution; all used paths (1, 2, 4) end up \
with approximately equal costs ~19.6 while the unused path 3 has higher cost \
- exactly Wardrop's principle.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->520]}
