            "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
           GridBoxSpacings->{"Columns" -> {
               Offset[0.7], {
                Offset[0.5599999999999999]}, 
               Offset[0.7]}, "Rows" -> {
               Offset[0.4], {
                Offset[0.8]}, 
               Offset[0.4]}}],
          DefaultBaseStyle->{},
          FrameMargins->{{5, 5}, {5, 5}}],
         BaselinePosition->Automatic,
         ImageMargins->0],
        Deinitialization:>None,
        DynamicModuleValues:>{},
        SynchronousInitialization->True,
        UndoTrackedVariables:>{Typeset`show$$, Typeset`bookmarkMode$$},
        UnsavedVariables:>{Typeset`initDone$$},
        UntrackedVariables:>{Typeset`size$$}], "ListAnimate",
       Deployed->True,
       StripOnInput->False],
      Manipulate`InterpretManipulate[1]]},
    {
     PaneBox[
      StyleBox["\<\"Figure 4. 50 IDM vehicles on a 1 km ring road. One \
vehicle is seeded at half speed at t=0; the instability propagates backward \
around the ring and crystallises into a persistent stop-and-go wave. Each \
disk is a vehicle coloured by its instantaneous speed (green = free flow, red \
= stopped). (MP4: Wolfram/results/anim_idm.mp4.)\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->520]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.6}}}],
  "Column"]], "Output",
 CellMargins->{{20, 20}, {10, 14}},
 ShowCellLabel->False,
 TextAlignment->Center,ExpressionUUID->"06179d94-1afe-4910-af11-563a1565e52f"],

Cell["5. The simplest car-following that jams: Bando OVM", "Section",ExpressionUUID->"de0f0181-de85-443a-8425-cb8a60181011"],

Cell["\<\
Even simpler than IDM, the Optimal Velocity Model (Bando et al. 1995) relaxes \
speed towards a target velocity that depends only on the gap to the vehicle \
ahead:\
\>", "Text",ExpressionUUID->"ccfb2687-fb36-4971-a733-673290ea326e"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"\[Kappa]", " ", 
    RowBox[{"[", 
     RowBox[{
      SubscriptBox["V", "opt"], "(", 
      SubscriptBox["s", "\[Alpha]"], ")", "-", 
      SubscriptBox["v", "\[Alpha]"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"21308d4c-f542-4da5-868d-b1f6967d210c"],

Cell["with the standard choice", "Text",ExpressionUUID->"5b019b8c-7451-4acf-a51a-d8501abf87be"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SubscriptBox["V", "opt"], "(", "s", ")"}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["v", "max"], "\[ThinSpace]", 
     RowBox[{"(", 
      RowBox[{"tanh", "(", 
       RowBox[{
        FractionBox["s", 
         SubscriptBox["s", "c"]], "-", "2"}], ")"}], "+", 
      RowBox[{"tanh", "(", "2", ")"}], ")"}]}], 
    RowBox[{"1", "+", 
     RowBox[{"tanh", "(", "2", ")"}]}]]}], TraditionalForm]], "DisplayFormula",\

 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"8145a469-15c6-4473-bc7f-223486f4c7a4"],

Cell[TextData[{
 "The model has a single stability parameter, the sensitivity ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "6cc96c5a-9f39-4a13-bcb5-e0307abb9536"],
 ". For ",
 Cell[BoxData[
  FormBox["\[Kappa]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0b53132d-bb84-4707-956b-406ec1efe770"],
 " above a critical value the uniform-flow solution is stable; below it, \
uniform flow is linearly unstable via a Hopf bifurcation and the system \
collapses into stop-and-go waves. This is the cleanest mathematical \
explanation for why phantom jams exist: they are the attractor of a dynamical \
bifurcation."
}], "Text",ExpressionUUID->"01d05390-61f8-42e6-b5f8-81a2f07a099e"],

