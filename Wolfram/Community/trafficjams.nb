    {
     PaneBox[
      StyleBox["\<\"Figure 3. Animated version of the same run: the \
hot-coloured block disperses, with the leftward shockfront clearly visible. \
The backward propagation speed equals the slope of the shock line on the \
space-time diagram.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
