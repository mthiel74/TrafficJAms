Cell["4. The microscopic view: Intelligent Driver Model", "Section",ExpressionUUID->"9f29e5f6-b07b-4712-8d55-f2c66e5338d6"],

Cell[TextData[{
 "Zooming in to the level of an individual vehicle \[LongDash] indexed ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "790fe8d1-1c08-4ae4-a935-f2f4b00fd1af"],
 " \[LongDash] the Intelligent Driver Model (Treiber, Hennecke & Helbing, \
2000) is a second-order ODE for the longitudinal dynamics. It is written as"
}], "Text",ExpressionUUID->"bc684f07-06d9-496e-b91f-e7e24311d9ff"],

Cell[BoxData[
 FormBox[
  RowBox[{
   OverscriptBox[
    SubscriptBox["v", "\[Alpha]"], "\[CenterDot]"], "=", 
   RowBox[{"a", " ", 
    RowBox[{"[", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         SubscriptBox["v", "\[Alpha]"], 
         SubscriptBox["v", "0"]], ")"}], "\[Delta]"], "-", 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          SuperscriptBox["s", "*"], "(", 
          SubscriptBox["v", "\[Alpha]"], ",", " ", 
          RowBox[{"\[CapitalDelta]", 
           SubscriptBox["v", "\[Alpha]"]}], ")"}], 
         SubscriptBox["s", "\[Alpha]"]], ")"}], "2"]}], "]"}]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"01c0c17a-987b-4b58-99fe-7a3c29f05fd4"],

Cell[TextData[{
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "c03298e7-ee90-439f-847a-f7757e1e8d6d"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "\[Alpha]"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "3e844e4e-7a55-4382-bde9-f4d2b1009d99"],
 " are the speed and gap to the vehicle in front, ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalDelta]", 
    SubscriptBox["v", "\[Alpha]"]}], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "5920a062-a5ba-46ab-abc5-e5bb28def80b"],
 " is the approach rate, and the desired gap is"
}], "Text",ExpressionUUID->"131db544-dc19-4a51-82fc-54ba6eb3c591"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{
    SuperscriptBox["s", "*"], "(", "v", ",", " ", "\[CapitalDelta]v", ")"}], "=", 
   RowBox[{
    SubscriptBox["s", "0"], "+", 
    RowBox[{"v", "\[ThinSpace]", "T"}], "+", 
    FractionBox[
     RowBox[{"v", "\[ThinSpace]", "\[CapitalDelta]v"}], 
     RowBox[{"2", 
      SqrtBox[
       RowBox[{"a", "\[ThinSpace]", "b"}]]}]]}]}], 
  TraditionalForm]], "DisplayFormula",
 TextAlignment->Center,
 FontFamily->"Times",ExpressionUUID->"830d8747-d5e4-449d-a510-b6f91977ed28"],

Cell[TextData[{
 "The constants have direct physical meaning: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "af0f8392-44f4-43cb-bade-c88bc50859e3"],
 " is the desired free-flow speed (typically 15\[ThinSpace]m/s on an urban \
road), ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["s", "0"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "baddcbb6-4071-44c0-bf10-70d1a74b5b36"],
 " is the minimum bumper gap at standstill (2\[ThinSpace]m), ",
 Cell[BoxData[
  FormBox["T", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "09b63ff8-46fe-4651-9a26-86904c7fa7b1"],
 " is the safe time headway to the leader (1.5\[ThinSpace]s), and ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "0e08c689-b788-4dc0-9c78-b9111e42420c"],
 ", ",
 Cell[BoxData[
  FormBox["b", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "66640067-82f2-4743-bd20-95fa4318a936"],
 " are the maximum acceleration and comfortable braking (1 and 1.5 m/s",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["", "2"], TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "548cf485-ed88-474a-8c69-7ec81239418a"],
 "). The acceleration exponent ",
 Cell[BoxData[
  FormBox["\[Delta]", TraditionalForm]], "InlineFormula",
  FontFamily->"Times",ExpressionUUID->
  "179e37c6-5437-4d78-9587-02999b922e5f"],
 " (typically 4) controls how sharply a driver eases off the accelerator as \
they approach their desired speed."
}], "Text",ExpressionUUID->"b49a1f24-1a85-4b8c-b981-6effe768dcef"],

Cell[TextData[{
 "Running 50 IDM vehicles on a 1\[ThinSpace]km circular road, with a \
single-vehicle speed perturbation, reproduces one of the most pedagogically \
useful results in all of traffic science: the ",
 StyleBox["phantom jam",
  FontSlant->Italic],
 ". The perturbation is not absorbed; instead it amplifies through the \
platoon into a persistent backward-propagating jam that has no visible \
external cause. A road that was a fraction away from instability collapses \
into a stop-and-go wave."
}], "Text",ExpressionUUID->"1ba6e5f0-8da8-4724-b7c8-524f77ae7ed5"],

