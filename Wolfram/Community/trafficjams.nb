       Selectable->False],
      DefaultBaseStyle->"ImageGraphics",
      ImageSize->680,
      ImageSizeRaw->{1300.32, 872.16},
      PlotRange->{{0, 1300.32}, {0, 872.16}}]},
    {
     PaneBox[
      StyleBox["\<\"Figure 17. Equilibrium on the realistic 15-node Aberdeen \
network. Left: saturation map of the 23 roads; the thickest red edge is Union \
Street. Right: top ten most-congested links, with Union Street at 3.0x \
capacity followed by Anderson Drive (south) and Berryden Road.\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->680]}
   },
   DefaultBaseStyle->"Column",
   GridBoxAlignment->{"Columns" -> {{Center}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{Automatic}}, "Rows" -> {{0.6}}}],
  "Column"]], "Output",
 CellMargins->{{0, 0}, {10, 14}},
 ShowCellLabel->False,ExpressionUUID->"fed40426-8a35-4dcc-a67f-059d72fbd528"],

Cell["10. Time-varying demand", "Section",ExpressionUUID->"39f3c25c-5622-4fd7-971a-a05d75e1459d"],

Cell["\<\
Real rush-hour demand is not a single number; it is a Gaussian-ish profile \
that builds up, peaks, and decays. We therefore run the Wardrop solve period \
by period, with some fraction of each period's flow carrying over as residual \
congestion that reduces the effective capacity for the next period:\
\>", "Text",ExpressionUUID->"0b300f31-a441-4abd-a5ef-68b86e8eb81b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"effectiveCap", "[", 
    RowBox[{"e", ",", " ", 
     RowBox[{"t", "+", "1"}]}], "]"}], " ", "=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"cap", "[", "e", "]"}], " ", "-", " ", 
      RowBox[{"0.3", " ", 
       RowBox[{"residual", "[", 
        RowBox[{"e", ",", " ", "t"}], "]"}]}]}], ",", " ", 
     RowBox[{"0.5", " ", 
      RowBox[{"cap", "[", "e", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"then", " ", "solve", " ", "Beckmann", " ", "on", " ", 
    RowBox[{"(", 
     RowBox[{"fft", ",", " ", "effectiveCap"}], ")"}], " ", "with", " ", 
    "that", " ", 
    RowBox[{"period", "'"}], "s", " ", "demand"}], " ", "*)"}]}]}], "Input",Ex\
pressionUUID->"0fb493e9-5d9d-4c3b-b044-45209637d255"],

Cell["\<\
This is a very coarse approximation to full Dynamic Traffic Assignment but \
captures the right qualitative behaviour: flows on the shortest route pile up \
first, spill over to secondary routes as the fastest route saturates, and \
decay asymmetrically on the way out of the peak because residual congestion \
persists.\
\>", "Text",ExpressionUUID->"aef5841e-0eb9-43fb-873e-53eccea2eea3"],

