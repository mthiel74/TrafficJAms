    {
     PaneBox[
      StyleBox["\<\"Figure 6. 100 NaSch vehicles on a 500-cell periodic \
lattice with randomisation probability p=0.3 and vMax=5 cells/step. Top \
panel: current positions, coloured by speed. Bottom panel: the space-time \
diagram grows line by line, and backward-propagating jam waves appear as \
diagonal dark bands. (MP4: Wolfram/results/anim_nasch.mp4.)\"\>",
       StripOnInput->False,
       FontFamily->"Helvetica",
       FontSize->10,
       FontSlant->Italic],
      Alignment->Center,
      ImageSize->520]}
   },
   DefaultBaseStyle->"Column",
